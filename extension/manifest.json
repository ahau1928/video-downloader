{
  "manifest_version": 3,
  "name": "视频下载器 · 浏览器助手",
  "version": "0.3.0",
  "description": "将 YouTube / Vimeo 视频及授权的登录信息发送到本机视频下载器。",
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*.youtube.com/*",
    "https://*.vimeo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "发送到视频下载器"
  },
  "key": ""
}